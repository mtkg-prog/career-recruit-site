# 本番デプロイ時に必須の環境変数
# Vercel の Settings > Environment Variables で設定してください。

# サイトの公開URL（OGP画像やcanonical URLに使用）
# 未設定の場合 og:image が localhost を指し、SNS共有時に画像が表示されない
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example

# カジュアル面談の申し込みフォームURL（Googleフォーム / HRMOS / Wantedly 等）
# 現在は通常応募フォームを仮設定。カジュアル面談専用フォーム作成後に差し替えること。
# 未設定の場合も同じ通常応募フォームにフォールバックする。
NEXT_PUBLIC_CASUAL_INTERVIEW_URL=https://docs.google.com/forms/d/e/1FAIpQLSdj427akjmsRonMHqZE0sRY8-OupKdu24KNIGGimrWq-AonHQ/viewform
